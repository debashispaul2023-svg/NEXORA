# FabInvests / NEXORA — example environment file
# Copy to .env and fill only if needed. Never commit real secrets.
# Paper trading only. Do not set real trading credentials.

# Optional overrides (safe defaults exist in config/config.example.json)
# FABINVESTS_MODE=paper
# FABINVESTS_LOOP_SECONDS=30
# FABINVESTS_DASHBOARD_PORT=3002
# FABINVESTS_TIMEZONE=UTC
# FABINVESTS_INITIAL_CAPITAL=1000
# FABINVESTS_CURRENCY=USD

# Logging
# FABINVESTS_LOG_LEVEL=info

# Market data (optional). Never commit a real key.
# FABINVESTS_ALPHAVANTAGE_KEY=
